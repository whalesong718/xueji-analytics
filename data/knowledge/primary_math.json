{
  "version": "1.0",
  "description": "小学数学教材知识库（人教版/通用课标要点），用于作业判题提示，不是模型微调权重",
  "grades": {
    "3": {
      "topics": [
        "万以内加减法",
        "多位数乘一位数",
        "分数的初步认识",
        "长方形正方形周长",
        "时间与长度单位换算",
        "简单两步应用题"
      ],
      "rules": [
        "加减法注意进位退位，结果数位是否正确",
        "乘法：乘法口诀与竖式对齐",
        "分数：几分之几表示平均分后的份数",
        "周长：长方形周长=(长+宽)×2；正方形周长=边长×4",
        "单位换算：1米=100厘米，1小时=60分钟"
      ],
      "common_errors": [
        "进位漏加/退位漏减",
        "竖式数位对不齐",
        "周长公式用成面积公式",
        "单位换算乘除颠倒"
      ]
    },
    "4": {
      "topics": [
        "三位数乘两位数",
        "除数是两位数的除法",
        "运算律（交换律、结合律、分配律）",
        "小数的意义与加减",
        "三角形角和",
        "平行四边形和梯形初步认识",
        "平均数"
      ],
      "rules": [
        "除法：先试商，余数必须小于除数",
        "运算律：a+b=b+a；(a+b)+c=a+(b+c)；a×(b+c)=a×b+a×c",
        "小数加减：小数点对齐后再计算",
        "三角形内角和=180度",
        "平均数=总和÷个数"
      ],
      "common_errors": [
        "试商偏大/偏小导致余数≥除数",
        "小数点未对齐",
        "把分配律写成 a×(b+c)=a×b+c",
        "角和记成 360 度",
        "求平均数时除错个数"
      ]
    },
    "5": {
      "topics": [
        "小数乘除法",
        "简易方程",
        "多边形面积",
        "分数加减法",
        "约分通分",
        "可能性初步"
      ],
      "rules": [
        "小数乘法：先按整数乘，再数小数位数确定小数点",
        "小数除法：除数化整数，被除数小数点同步移动",
        "方程：左右同时加减乘除，保持等式平衡",
        "平行四边形面积=底×高；三角形面积=底×高÷2；梯形面积=(上底+下底)×高÷2",
        "分数加减：先通分再加减，结果要约分"
      ],
      "common_errors": [
        "小数乘法小数点位数数错",
        "方程移项变号错误",
        "三角形面积漏除以2",
        "分数通分错误或未约分",
        "高不是对应底边上的高"
      ]
    },
    "6": {
      "topics": [
        "分数乘除法",
        "比和比例",
        "圆的周长和面积",
        "百分数",
        "圆柱圆锥体积",
        "比例尺与正反比例"
      ],
      "rules": [
        "分数乘法：分子乘分子、分母乘分母，能约分先约分",
        "分数除法：除以一个数=乘它的倒数",
        "圆：C=2πr=πd；S=πr²（通常π取3.14）",
        "百分数：a是b的百分之几 = a÷b×100%",
        "圆柱体积=底面积×高；圆锥体积=1/3×底面积×高"
      ],
      "common_errors": [
        "分数除法忘记乘倒数",
        "圆面积用成 2πr",
        "百分数题目单位1找错",
        "圆锥体积漏乘1/3",
        "比的前后项写反"
      ]
    }
  },
  "grading_principles": [
    "最终答案正确即判对，不因步骤不完整判错",
    "单位正确与否按题目要求：题目要单位而学生漏写，可在 error_detail 说明，但若数值正确且题目未强制单位格式，优先判对",
    "看不清才判空题，不要猜错",
    "同一题不要既说正确又给错误类型",
    "应用题关注数量关系：谁是总数、每份数、份数"
  ],
